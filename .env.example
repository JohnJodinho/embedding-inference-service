# Client API keys (configure as Hugging Face Space Secrets; never commit real values)
RAG_API_KEY=replace-with-a-long-random-secret-for-the-rag-application
ZIT_API_KEY=replace-with-a-different-long-random-secret-for-the-zit-assistant

# Model revisions are pinned in app/config.py (immutable commit hashes).

# Runtime limits (defaults are shown; adjust only after measuring the Space).
MINILM_QUEUE_CAPACITY=32
BGE_QUEUE_CAPACITY=32
MAX_BATCH_SIZE=8
MICRO_BATCH_WINDOW_MS=200
REQUEST_TIMEOUT_SECONDS=90
INFERENCE_TIMEOUT_SECONDS=60
MAX_REQUEST_BYTES=262144
MAX_TEXTS_PER_REQUEST=8
MAX_BGE_TEXTS_PER_REQUEST=4
MAX_CHARS_PER_TEXT=2048
MAX_TOKENS_PER_TEXT=512
TORCH_NUM_THREADS=2
TORCH_NUM_INTEROP_THREADS=1
